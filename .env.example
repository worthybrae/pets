# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# OpenAI (Pet Brain + Embeddings)
OPENAI_API_KEY=

# Live Mimo worker. Set MIMO_MODEL to a chat-completions model available at
# MIMO_MODEL_URL. For a local compatible server, set MIMO_MODEL_URL to its
# /v1/chat/completions endpoint and leave OPENAI_API_KEY blank if it needs no key.
MIMO_MODEL=gpt-6-luna
MIMO_MODEL_URL=https://api.openai.com/v1/chat/completions
MIMO_MODEL_API_KEY=
MIMO_TICK_SECONDS=20
MIMO_THINK_SECONDS=900
MIMO_MAX_DECISIONS_PER_DAY=64

# Redis
REDIS_URL=redis://localhost:6379

# Frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# App
APP_ENV=development
