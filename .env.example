# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# OpenAI (Pet Brain + Embeddings)
OPENAI_API_KEY=

# Jev is Mimo's fast action selector. Keep this server-side only.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Survival brain. With TYPESAFE_API_KEY, Jev chooses Mimo's purposes. With only an
# OpenAI key (OPENAI_API_KEY or MIMO_MODEL_API_KEY), Luna does; MIMO_MODEL must be a
# chat model at MIMO_MODEL_URL. With neither, rules choose. With both keys, Luna may
# add a short reflection (at most 12 a day). The caps count model calls per UTC day;
# when one is spent, rules take over. On top of the caps, at most 8 model picks happen per
# game hour, and rules re-choose after short purposes (rest, explore, eat, go home).
MIMO_MODEL=gpt-6-luna
MIMO_MODEL_URL=https://api.openai.com/v1/chat/completions
MIMO_MODEL_API_KEY=
MIMO_TICK_SECONDS=1
MIMO_MAX_DECISIONS_PER_DAY=200
MIMO_MAX_LUNA_DECISIONS_PER_DAY=64
# Survival lives. The worker ticks the active life every MIMO_TICK_SECONDS. MIMO_TIME_SCALE
# speeds the clock and every vital for manual tests only (60 makes a game day one real minute).
# The life registry and survival worlds live in MIMO_DATA_DIR (default /data).
MIMO_TIME_SCALE=1
# MIMO_ACTION_SCALE makes Mimo's steps that many times shorter, for manual tests only
# (use 60 with MIMO_TIME_SCALE=60 to watch a whole day of purposes). Only the worker reads it.
MIMO_ACTION_SCALE=1

# Redis
REDIS_URL=redis://localhost:6379

# Frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# App
APP_ENV=development
